{
    "name": "getoutbox/outbox-laravel",
    "description": "Outbox Stack mail driver and webhooks for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "mail",
        "email",
        "transactional",
        "outbox"
    ],
    "homepage": "https://outboxstack.app/docs",
    "require": {
        "php": "^8.2",
        "getoutbox/outbox-php": "^0.1",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/mail": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "symfony/mailer": "^7.0 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Outbox\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Outbox\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Outbox\\Laravel\\OutboxServiceProvider"
            ],
            "aliases": {
                "Outbox": "Outbox\\Laravel\\Facades\\Outbox"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "support": {
        "issues": "https://github.com/Outbox-Stack/outbox-laravel/issues",
        "source": "https://github.com/Outbox-Stack/outbox-laravel",
        "docs": "https://outboxstack.app/docs"
    }
}
